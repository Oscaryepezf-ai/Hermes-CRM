generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  logoUrl              String?
  phone                String?
  address              String?
  city                 String?
  country              String   @default("EC")
  plan                 Plan     @default(STARTER)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // ─── Canales Meta ─────────────────────────────────────
  facebookPageId   String?
  messengerActive  Boolean @default(false)
  instagramActive  Boolean @default(false)

  // ─── Hermes Captador ──────────────────────────────────
  captadorActive   Boolean @default(false)
  captadorConfig   Json?

  // ─── Hermes Reactivador ───────────────────────────────
  reactivadorActive  Boolean @default(false)
  reactivadorConfig  Json?

  // ─── Onboarding / activación ──────────────────────────
  practiceType        PracticeType?
  currentTools        CurrentTools?
  onboardingStep      Int           @default(0)
  onboardingCompleted Boolean       @default(false)
  rewardClaimed       Boolean       @default(false)
  rewardClaimedAt     DateTime?

  // ─── Super Admin: suspensión de la clínica completa ──
  suspendedAt     DateTime?
  suspendedReason String?

  users                 User[]
  leads                 Lead[]
  patients              Patient[]
  appointments          Appointment[]
  pipelineStages        PipelineStage[]
  invitations           UserInvitation[]
  aiUsageLogs           AiUsageLog[]
  channels              ClinicChannel[]
  reactivationCampaigns ReactivationCampaign[]
  inboxConversations    InboxConversation[]
  inboxLabels           InboxLabel[]
  clinicalVisits        ClinicalVisit[]
  orthodonticVisits     OrthodonticVisit[]
  prescriptions         Prescription[]
  patientFiles          PatientFile[]
  activationMissions    ActivationMission[]
  services              Service[]
  payments              Payment[]
  expenses              Expense[]
  knowledgeDocuments    KnowledgeDocument[]
  flows                 Flow[]
  userClinics           UserClinic[]
}

model ClinicChannel {
  id          String           @id @default(cuid())
  clinicId    String
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  channel     MarketingChannel
  isActive    Boolean          @default(false)
  pageId      String?
  accessToken String?          @db.Text
  webhookId   String?
  connectedAt DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([clinicId, channel])
  @@index([clinicId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(RECEPTIONIST)
  avatarUrl String?
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  createdAt DateTime @default(now())

  isActive            Boolean               @default(true)
  isSuperAdmin        Boolean               @default(false)
  invitedByUserId     String?
  invitedAt           DateTime?
  lastLoginAt         DateTime?

  // ─── Registro por WhatsApp ─────────────────────────────
  phone             String?           @unique
  phoneVerified     Boolean           @default(false)
  selfReportedRole  SelfReportedRole?

  leadHistory                 LeadHistory[]
  appointments                Appointment[]
  assignedLeads               Lead[]                @relation("AssignedLeads")
  googleCalendarToken         GoogleCalendarToken?
  pushSubscriptions           PushSubscription[]
  sentInvitations             UserInvitation[]      @relation("SentInvitations")
  journeyEvents               JourneyEvent[]
  assignedInboxConversations  InboxConversation[]   @relation("AssignedInboxConversations")
  clinicalVisits              ClinicalVisit[]       @relation("DoctorVisits")
  orthodonticVisits           OrthodonticVisit[]    @relation("OrthoDoctorVisits")
  prescriptions               Prescription[]        @relation("DoctorPrescriptions")
  uploadedFiles                PatientFile[]        @relation("UploadedFiles")
  superAdminActions            SuperAdminAuditLog[] @relation("SuperAdminActions")
  doctorPayments                Payment[]            @relation("DoctorPayments")
  userClinics                  UserClinic[]
}

// Acceso adicional a clínicas más allá de la clínica de origen (User.clinicId)
// — permite que un mismo usuario (ej. una recepcionista) opere varias
// clínicas distintas alternando entre ellas sin tener cuentas separadas.
model UserClinic {
  userId    String
  clinicId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, clinicId])
  @@index([clinicId])
}

model SuperAdminAuditLog {
  id          String           @id @default(cuid())
  adminUserId String
  adminUser   User             @relation("SuperAdminActions", fields: [adminUserId], references: [id])
  action      SuperAdminAction
  targetType  String
  targetId    String
  targetLabel String
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
}

enum SuperAdminAction {
  CLINIC_CREATED
  CLINIC_PLAN_CHANGED
  CLINIC_SUSPENDED
  CLINIC_REACTIVATED
  USER_ROLE_CHANGED
  USER_PASSWORD_RESET
  USER_ACTIVATED
  USER_DEACTIVATED
}

model GoogleCalendarToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  calendarId   String   @default("primary")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PipelineStage {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id])

  name          String
  slug          String   @default("")
  color         String   @default("#6366F1")
  bgColor       String   @default("#EEF3FC")
  headerBgColor String   @default("#DDE8F8")
  order         Int
  isProtected   Boolean  @default(false)
  isDefault     Boolean  @default(false)
  isCustom      Boolean  @default(false)
  icon          String?

  leads         Lead[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clinicId, order])
}

model Lead {
  id             String           @id @default(cuid())
  fullName       String
  phone          String
  email          String?
  // Campos legacy del Kanban (se mantienen para no romper el pipeline visual)
  source         LeadSource       @default(REFERIDO)
  interest       String?
  estimatedValue Float?
  notes          String?
  stageId        String?
  stage          PipelineStage?   @relation(fields: [stageId], references: [id])
  convertedAt    DateTime?
  patientId      String?
  // Campos nuevos del pipeline comercial
  status         LeadStatus       @default(NUEVO)
  treatment      DentalTreatment  @default(OTRO)
  channel        MarketingChannel @default(OTRO)
  assignedToId   String?
  assignedTo     User?            @relation("AssignedLeads", fields: [assignedToId], references: [id])
  lastContactAt  DateTime?
  clinicId       String
  clinic         Clinic           @relation(fields: [clinicId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // ─── Journey fields ───────────────────────────────────────
  journeyState      JourneyState  @default(PROSPECTO)
  interestLevel     Int?
  budgetRange       BudgetRange?
  consultationDate  DateTime?
  conversionValue   Float?
  lostReason        LostReason?
  lostAt            DateTime?
  lastActivityAt    DateTime?
  totalTouchpoints  Int           @default(0)
  responseTimeAvg   Float?

  isAgentHandled       Boolean @default(false)
  isNewPatientOfMonth  Boolean @default(false)
  convertedThisMonth   Boolean @default(false)

  history               LeadHistory[]
  messages              Message[]
  clinicalHistory       ClinicalHistory?
  clinicalVisits        ClinicalVisit[]
  orthodonticHistory    OrthodonticHistory?
  orthodonticVisits     OrthodonticVisit[]
  prescriptions         Prescription[]
  files                 PatientFile[]
  journeyEvents         JourneyEvent[]
  socialProfiles        SocialProfile[]
  agentConversation     AgentConversation?
  reactivationCampaigns ReactivationCampaign[]
  inboxConversations    InboxConversation[]

  // ─── Filiación (ficha 360) ────────────────────────────────
  nickname       String?
  documentType   DocumentType? @default(CEDULA)
  documentNumber String?
  birthDate      DateTime?
  birthCountry   String?
  landline       String?
  address        String?
  sex            Sex?
  insurer        String?
  businessLine   String?
  patientGroup   String?
  occupation     String?
  additionalInfo String?
  hcNumber       String?

  @@index([clinicId, createdAt(sort: Desc)])
  @@index([clinicId, stageId])
  @@index([clinicId, status])
}

model ClinicalHistory {
  id                String   @id @default(cuid())
  leadId            String   @unique
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  reasonForConsult  String?  @db.Text
  medicalHistory    String?  @db.Text
  dentalHistory     String?  @db.Text
  odontogramNotes   String?  @db.Text
  odontogramData    Json?
  proposedTreatment String?  @db.Text
  observations      String?  @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Message {
  id                String           @id @default(cuid())
  leadId            String
  lead              Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction         MsgDirection
  content           String
  mediaUrl          String?
  status            MsgStatus        @default(SENT)
  sentAt            DateTime         @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?
  channel           MarketingChannel @default(WHATSAPP)
  externalMessageId String?          @db.Text
  isAutomatic       Boolean          @default(false)
  isNote            Boolean          @default(false)

  @@index([externalMessageId])
  @@index([leadId, channel, sentAt])
}

model LeadHistory {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  fromStage String?
  toStage   String
  note      String?
  createdAt DateTime @default(now())
}

model Patient {
  id        String    @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  birthDate DateTime?
  cedula    String?
  address   String?
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  createdAt DateTime  @default(now())

  appointments Appointment[]
  payments     Payment[]
}

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id])
  clinicId           String
  clinic             Clinic            @relation(fields: [clinicId], references: [id])
  dentistId          String
  dentist            User              @relation(fields: [dentistId], references: [id])
  procedure          String
  value              Float?
  status             AppointmentStatus @default(SCHEDULED)
  scheduledAt        DateTime
  notes              String?
  createdAt          DateTime          @default(now())
  // Agendador fields
  googleEventId      String?
  reminderSentAt     DateTime?
  reminderStatus     ReminderStatus    @default(PENDING)
  confirmationCode   String?           @default(cuid())
  patientConfirmed   Boolean           @default(false)

  payments           Payment[]
}

// ─── Reportes: catálogo de servicios, pagos y egresos ──────────────────────
model Service {
  id           String          @id @default(cuid())
  clinicId     String
  clinic       Clinic          @relation(fields: [clinicId], references: [id])
  name         String
  category     DentalTreatment @default(OTRO)
  defaultPrice Float
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  payments     Payment[]

  @@unique([clinicId, name])
}

model Payment {
  id              String        @id @default(cuid())
  clinicId        String
  clinic          Clinic        @relation(fields: [clinicId], references: [id])
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id])
  appointmentId   String?
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id])
  serviceId       String?
  service         Service?      @relation(fields: [serviceId], references: [id])
  doctorId        String
  doctor          User          @relation("DoctorPayments", fields: [doctorId], references: [id])

  amount          Float
  paymentMethod   PaymentMethod
  receiptType     ReceiptType   @default(RECIBO)
  discount1       Float?
  discount2       Float?
  commissionPct   Float?
  commissionValue Float?
  comment         String?

  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([clinicId, paidAt])
  @@index([clinicId, doctorId])
}

model Expense {
  id          String          @id @default(cuid())
  clinicId    String
  clinic      Clinic          @relation(fields: [clinicId], references: [id])
  category    ExpenseCategory
  description String
  amount      Float
  expenseDate DateTime
  createdAt   DateTime        @default(now())

  @@index([clinicId, expenseDate])
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum ReceiptType {
  RECIBO
  FACTURA
}

enum ExpenseCategory {
  INSUMOS
  ARRIENDO
  NOMINA
  SERVICIOS_BASICOS
  MARKETING
  EQUIPAMIENTO
  OTRO
}

// ─── Enums existentes ──────────────────────────────────────────────────────────

enum Plan {
  STARTER
  PROFESIONAL
  CLINICA
}

enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum LeadSource {
  REFERIDO
  INSTAGRAM
  FACEBOOK
  GOOGLE
  TIKTOK
  WHATSAPP
  OTRO
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─── Enums nuevos del pipeline comercial ──────────────────────────────────────

enum LeadStatus {
  NUEVO
  CONTACTADO
  CITA_AGENDADA
  PRESUPUESTO_ENVIADO
  CONVERTIDO
  PERDIDO
}

enum DentalTreatment {
  ORTODONCIA
  IMPLANTES
  BLANQUEAMIENTO
  ENDODONCIA
  LIMPIEZA
  CIRUGIA
  PROTESIS
  OTRO
}

enum MarketingChannel {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  GOOGLE
  REFERIDO
  TIKTOK
  OTRO
}

enum DocumentType {
  CEDULA
  PASAPORTE
  RUC
  OTRO
}

enum Sex {
  HOMBRE
  MUJER
}

enum MsgDirection {
  INBOUND
  OUTBOUND
}

enum MsgStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Enums del Agendador ───────────────────────────────────────────────────────

enum ReminderStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
  NOT_NEEDED
}

model UserInvitation {
  id          String    @id @default(cuid())
  email       String
  role        UserRole
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  invitedById String
  invitedBy   User      @relation("SentInvitations", fields: [invitedById], references: [id])
  token       String    @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([email, clinicId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Journey / Proceso Comercial ──────────────────────────────────────────────

model JourneyEvent {
  id          String        @id @default(cuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  type        EventType
  fromState   JourneyState?
  toState     JourneyState?
  metadata    Json?
  note        String?
  isAutomatic Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([leadId])
}

enum JourneyState {
  PROSPECTO
  CALIFICADO
  CITA_AGENDADA
  EN_CONSULTA
  PACIENTE_ACTIVO
  INACTIVO
  PERDIDO
}

enum BudgetRange {
  BAJO
  MEDIO
  ALTO
  PREMIUM
}

enum LostReason {
  PRECIO_ALTO
  ELIGIO_OTRA
  NO_RESPONDE
  NO_NECESITA
  MALA_EXPERIENCIA
  OTRO
}

enum EventType {
  STATE_CHANGED
  MESSAGE_SENT
  MESSAGE_RECEIVED
  CALL_MADE
  QUICK_REPLY_USED
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  NO_SHOW
  CLINICAL_NOTE_ADDED
  DICTATION_USED
  CONVERTED_TO_PATIENT
  LOST
  AI_QUALIFIED
  AI_SCHEDULED
  AI_REMINDER_SENT
  AI_REENGAGED
}

// ─── Canal Social — Perfiles de redes sociales ────────────────────────────────

model SocialProfile {
  id            String           @id @default(cuid())
  leadId        String
  lead          Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel       MarketingChannel
  externalId    String           // PSID de Facebook, IG user ID, etc.
  displayName   String?
  profilePicUrl String?
  locale        String?
  timezone      Int?
  rawProfile    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([channel, externalId])
  @@index([externalId])
}

// ─── Hermes Captador ──────────────────────────────────────────────────────────

model AgentConversation {
  id             String             @id @default(cuid())
  leadId         String             @unique
  lead           Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentType      AgentType          @default(CAPTADOR)
  status         ConversationStatus @default(ACTIVE)
  channel        MarketingChannel
  turnCount      Int                @default(0)
  lastAgentMsgAt DateTime?
  handedOffAt    DateTime?
  handoffReason  String?
  collectedData  Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // ─── Agente de Ventas Consultivo (modo "consultivo") ───
  detectedNeeds    Json       @default("[]")
  objections       Json       @default("[]")
  rapportScore     Int        @default(0)
  salesStage       SalesStage @default(CONEXION)
  resourcesSent    Json       @default("[]")
  emotionalState   String?
  decisionTimeline String?
  preferredTone    String?

  // ─── Constructor de Flujos (modo "flujo") ───
  currentFlowNodeId String?
}

enum AgentType {
  CAPTADOR
  AGENDADOR
  REACTIVADOR
}

enum SalesStage {
  CONEXION
  INDAGACION
  CONSTRUCCION_VALOR
  MANEJO_OBJECIONES
  CIERRE_SUAVE
  LISTO_PARA_HUMANO
}

enum ConversationStatus {
  ACTIVE
  HANDED_OFF
  COMPLETED
  ABANDONED
}

// ─── Base de conocimiento (RAG) — Agente de Ventas Consultivo ────────────────

model KnowledgeDocument {
  id         String              @id @default(cuid())
  clinicId   String
  clinic     Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  title      String
  sourceType KnowledgeSourceType
  rawContent String              @db.Text
  createdAt  DateTime            @default(now())

  chunks KnowledgeChunk[]

  @@index([clinicId])
}

enum KnowledgeSourceType {
  TEXTO_MANUAL
  FAQ
  TESTIMONIOS
  GUION_OBJECIONES
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  documentId String
  document   KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  clinicId   String
  content    String                       @db.Text
  embedding  Unsupported("vector(1536)")?
  chunkIndex Int
  createdAt  DateTime                     @default(now())

  @@index([clinicId])
}

// ─── Constructor de Flujos (modo "flujo" del Captador) ────────────────────────

model Flow {
  id          String     @id @default(cuid())
  clinicId    String
  clinic      Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  startNodeId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  nodes       FlowNode[]

  @@index([clinicId])
}

enum FlowNodeType {
  MESSAGE
  HANDOFF
  END
}

model FlowNode {
  id        String       @id @default(cuid())
  flowId    String
  flow      Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  type      FlowNodeType @default(MESSAGE)
  text      String       @db.Text
  mediaUrl  String?
  mediaType String?
  buttons   Json         @default("[]")
  positionX Float        @default(0)
  positionY Float        @default(0)

  @@index([flowId])
}

// ─── AI Usage Tracking ────────────────────────────────────────────────────────

model AiUsageLog {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  agentKey      String
  model         String
  tokensInput   Int      @default(0)
  tokensOutput  Int      @default(0)
  audioDuration Float?
  costUsd       Float
  latencyMs     Int
  success       Boolean
  errorCode     String?
  createdAt     DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([agentKey, createdAt])
}

// ─── Hermes Reactivador ───────────────────────────────────────────────────────

model ReactivationCampaign {
  id                 String              @id @default(cuid())
  clinicId           String
  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  leadId             String
  lead               Lead                @relation(fields: [leadId], references: [id])

  segment            ReactivationSegment
  treatmentFocus     String?
  daysSinceLastAppt  Int

  status             CampaignStatus      @default(PENDING)
  attemptCount       Int                 @default(0)
  maxAttempts        Int                 @default(3)
  lastAttemptAt      DateTime?
  nextAttemptAt      DateTime?

  responded          Boolean             @default(false)
  respondedAt        DateTime?
  convertedAt        DateTime?
  revenue            Float?

  messages           CampaignMessage[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([clinicId, leadId])
  @@index([clinicId, status])
  @@index([nextAttemptAt])
}

model CampaignMessage {
  id             String               @id @default(cuid())
  campaignId     String
  campaign       ReactivationCampaign @relation(fields: [campaignId], references: [id])
  channel        MarketingChannel
  content        String               @db.Text
  attemptNumber  Int
  sentAt         DateTime             @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  repliedAt      DateTime?
  externalMsgId  String?
}

enum ReactivationSegment {
  TRATAMIENTO_INCOMPLETO
  CONTROL_PENDIENTE
  LARGO_PLAZO_INACTIVO
  PERDIO_PRESUPUESTO
  SIN_CLASIFICAR
}

enum CampaignStatus {
  PENDING
  ACTIVE
  RESPONDED
  CONVERTED
  EXHAUSTED
  CANCELLED
}

// ─── Historial de visitas clínicas ────────────────────────────────────────────

model ClinicalVisit {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  doctorId     String
  doctor       User     @relation("DoctorVisits", fields: [doctorId], references: [id])
  visitDate    DateTime @default(now())

  procedures   String?  @db.Text   // Procedimientos realizados
  findings     String?  @db.Text   // Hallazgos clínicos
  medications  String?  @db.Text   // Medicamentos / recetas
  instructions String?  @db.Text   // Indicaciones al paciente
  followUp     String?  @db.Text   // Seguimiento / próxima cita
  notes        String?  @db.Text   // Notas internas

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([leadId, visitDate])
  @@index([clinicId, visitDate])
}

// ─── Historia clínica de ortodoncia ───────────────────────────────────────────

model OrthodonticHistory {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Motivo de consulta y antecedentes
  chiefComplaint      String? @db.Text
  priorOrthoTreatment String? @db.Text

  // Análisis facial (extraoral)
  facialType      String?
  facialSymmetry  String?
  profileType     String?
  lipCompetence   String?
  nasolabialAngle String?
  facialNotes     String? @db.Text

  // Análisis funcional
  breathingType   String?
  swallowingType  String?
  habits          String[]
  tmjFindings     String? @db.Text
  functionalNotes String? @db.Text

  // Análisis dental y oclusal (intraoral)
  angleClassRight       String?
  angleClassLeft        String?
  molarRelationRight    String?
  molarRelationLeft     String?
  canineRelationRight   String?
  canineRelationLeft    String?
  overjetMm             Float?
  overbiteMm            Float?
  upperMidlineDeviation String?
  lowerMidlineDeviation String?
  crowdingUpperMm       Float?
  crowdingLowerMm       Float?
  spacingUpperMm        Float?
  spacingLowerMm        Float?
  crossbite             String[]
  openBite              Boolean? @default(false)
  curveOfSpee           String?
  missingTeeth          String? @db.Text
  impactedTeeth         String? @db.Text
  occlusalNotes         String? @db.Text

  // Análisis cefalométrico
  snaAngle           Float?
  snbAngle           Float?
  anbAngle           Float?
  fmaAngle           Float?
  skeletalClass      String?
  cephalometricNotes String? @db.Text

  // Diagnóstico ortodóntico
  skeletalDiagnosis   String? @db.Text
  dentalDiagnosis     String? @db.Text
  functionalDiagnosis String? @db.Text

  // Plan de tratamiento
  treatmentPhase          String?
  applianceType           String?
  extractionsPlanned      String? @db.Text
  treatmentObjectives     String? @db.Text
  estimatedDurationMonths Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrthodonticVisit {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  doctorId  String
  doctor    User     @relation("OrthoDoctorVisits", fields: [doctorId], references: [id])
  visitDate DateTime @default(now())

  upperArchwire   String?
  lowerArchwire   String?
  elastics        String?
  proceduresDone  String?   @db.Text
  oralHygiene     String?
  observations    String?   @db.Text
  nextAppointment DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, visitDate])
  @@index([clinicId, visitDate])
}

// ─── Prescripciones ────────────────────────────────────────────────────────────

model Prescription {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  doctorId     String
  doctor       User     @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  issuedAt     DateTime @default(now())

  diagnosis    String?  @db.Text
  instructions String?  @db.Text
  medications  Json     // [{ name, dose, frequency, duration, notes }]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([leadId, issuedAt])
  @@index([clinicId, issuedAt])
}

// ─── Archivos del paciente ──────────────────────────────────────────────────────

model PatientFile {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  uploadedById String
  uploadedBy   User     @relation("UploadedFiles", fields: [uploadedById], references: [id])

  fileName     String
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?
  category     String?
  notes        String?  @db.Text

  createdAt    DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([clinicId, createdAt])
}

// ─── Bandeja de Entrada (Inbox) ───────────────────────────────────────────────

enum InboxStatus {
  OPEN
  PENDING
  RESOLVED
}

model InboxConversation {
  id                 String        @id @default(cuid())
  clinicId           String
  clinic             Clinic        @relation(fields: [clinicId], references: [id])
  leadId             String
  lead               Lead          @relation(fields: [leadId], references: [id])
  channel            MarketingChannel
  status             InboxStatus   @default(OPEN)
  assignedToId       String?
  assignedTo         User?         @relation("AssignedInboxConversations", fields: [assignedToId], references: [id])
  isRead             Boolean       @default(false)
  lastMessageAt      DateTime?
  lastMessagePreview String?       @db.VarChar(200)
  unreadCount        Int           @default(0)
  isPinned           Boolean       @default(false)
  labels             InboxConversationLabel[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([leadId, channel])
  @@index([clinicId, status, lastMessageAt])
  @@index([clinicId, isRead])
}

model InboxLabel {
  id            String                   @id @default(cuid())
  clinicId      String
  clinic        Clinic                   @relation(fields: [clinicId], references: [id])
  name          String
  color         String
  emoji         String?
  createdAt     DateTime                 @default(now())
  conversations InboxConversationLabel[]

  @@unique([clinicId, name])
}

model InboxConversationLabel {
  id             String            @id @default(cuid())
  conversationId String
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  labelId        String
  label          InboxLabel        @relation(fields: [labelId], references: [id])
  createdAt      DateTime          @default(now())

  @@unique([conversationId, labelId])
}

// ─── Registro por WhatsApp ────────────────────────────────────────────────────

model PhoneVerification {
  id        String   @id @default(cuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

// ─── Checklist gamificado de activación ───────────────────────────────────────

model ActivationMission {
  id          String      @id @default(cuid())
  clinicId    String
  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  missionKey  MissionKey
  completed   Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  @@unique([clinicId, missionKey])
}

enum MissionKey {
  CUENTA_CREADA
  CREAR_CITA
  REGISTRAR_EVOLUCION
}

enum PracticeType {
  ODONTOLOGIA
  ORTODONCIA_ESPECIALIZADA
  RED_DENTAL
  OTRO
}

enum CurrentTools {
  PAPEL
  HERRAMIENTAS_SUELTAS
  SOFTWARE_ESPECIALIZADO
}

enum SelfReportedRole {
  DUENO_CONSULTORIO
  ADMINISTRADOR
  RECEPCIONISTA
  PROFESIONAL_MULTISEDE
  ESTUDIANTE
  OTRO
}
