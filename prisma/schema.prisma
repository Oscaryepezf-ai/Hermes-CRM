generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  logoUrl              String?
  phone                String?
  address              String?
  city                 String?
  country              String   @default("CO")
  plan                 Plan     @default(STARTER)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // ─── Canales Meta ─────────────────────────────────────
  facebookPageId   String?
  messengerActive  Boolean @default(false)
  instagramActive  Boolean @default(false)

  // ─── Hermes Captador ──────────────────────────────────
  captadorActive   Boolean @default(false)
  captadorConfig   Json?

  // ─── Hermes Reactivador ───────────────────────────────
  reactivadorActive  Boolean @default(false)
  reactivadorConfig  Json?

  users                 User[]
  leads                 Lead[]
  patients              Patient[]
  appointments          Appointment[]
  pipelineStages        PipelineStage[]
  invitations           UserInvitation[]
  aiUsageLogs           AiUsageLog[]
  channels              ClinicChannel[]
  reactivationCampaigns ReactivationCampaign[]
}

model ClinicChannel {
  id          String           @id @default(cuid())
  clinicId    String
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  channel     MarketingChannel
  isActive    Boolean          @default(false)
  pageId      String?
  accessToken String?          @db.Text
  webhookId   String?
  connectedAt DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([clinicId, channel])
  @@index([clinicId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(RECEPTIONIST)
  avatarUrl String?
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  createdAt DateTime @default(now())

  isActive            Boolean               @default(true)
  isSuperAdmin        Boolean               @default(false)
  invitedByUserId     String?
  invitedAt           DateTime?
  lastLoginAt         DateTime?

  leadHistory         LeadHistory[]
  appointments        Appointment[]
  assignedLeads       Lead[]                @relation("AssignedLeads")
  googleCalendarToken GoogleCalendarToken?
  pushSubscriptions   PushSubscription[]
  sentInvitations     UserInvitation[]      @relation("SentInvitations")
  journeyEvents       JourneyEvent[]
}

model GoogleCalendarToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  calendarId   String   @default("primary")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PipelineStage {
  id       String @id @default(cuid())
  name     String
  order    Int
  color    String @default("#6366f1")
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  leads Lead[]
}

model Lead {
  id             String           @id @default(cuid())
  fullName       String
  phone          String
  email          String?
  // Campos legacy del Kanban (se mantienen para no romper el pipeline visual)
  source         LeadSource       @default(REFERIDO)
  interest       String?
  estimatedValue Float?
  notes          String?
  stageId        String?
  stage          PipelineStage?   @relation(fields: [stageId], references: [id])
  convertedAt    DateTime?
  patientId      String?
  // Campos nuevos del pipeline comercial
  status         LeadStatus       @default(NUEVO)
  treatment      DentalTreatment  @default(OTRO)
  channel        MarketingChannel @default(OTRO)
  assignedToId   String?
  assignedTo     User?            @relation("AssignedLeads", fields: [assignedToId], references: [id])
  lastContactAt  DateTime?
  clinicId       String
  clinic         Clinic           @relation(fields: [clinicId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // ─── Journey fields ───────────────────────────────────────
  journeyState      JourneyState  @default(PROSPECTO)
  interestLevel     Int?
  budgetRange       BudgetRange?
  consultationDate  DateTime?
  conversionValue   Float?
  lostReason        LostReason?
  lostAt            DateTime?
  lastActivityAt    DateTime?
  totalTouchpoints  Int           @default(0)
  responseTimeAvg   Float?

  isAgentHandled    Boolean @default(false)

  history               LeadHistory[]
  messages              Message[]
  clinicalHistory       ClinicalHistory?
  journeyEvents         JourneyEvent[]
  socialProfiles        SocialProfile[]
  agentConversation     AgentConversation?
  reactivationCampaigns ReactivationCampaign[]
}

model ClinicalHistory {
  id                String   @id @default(cuid())
  leadId            String   @unique
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  reasonForConsult  String?  @db.Text
  medicalHistory    String?  @db.Text
  dentalHistory     String?  @db.Text
  odontogramNotes   String?  @db.Text
  proposedTreatment String?  @db.Text
  observations      String?  @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Message {
  id                String           @id @default(cuid())
  leadId            String
  lead              Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction         MsgDirection
  content           String
  mediaUrl          String?
  status            MsgStatus        @default(SENT)
  sentAt            DateTime         @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?
  channel           MarketingChannel @default(WHATSAPP)
  externalMessageId String?          @db.Text
  isAutomatic       Boolean          @default(false)

  @@index([externalMessageId])
}

model LeadHistory {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fromStage String?
  toStage   String
  note      String?
  createdAt DateTime @default(now())
}

model Patient {
  id        String    @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  birthDate DateTime?
  cedula    String?
  address   String?
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  createdAt DateTime  @default(now())

  appointments Appointment[]
}

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id])
  clinicId           String
  clinic             Clinic            @relation(fields: [clinicId], references: [id])
  dentistId          String
  dentist            User              @relation(fields: [dentistId], references: [id])
  procedure          String
  value              Float?
  status             AppointmentStatus @default(SCHEDULED)
  scheduledAt        DateTime
  notes              String?
  createdAt          DateTime          @default(now())
  // Agendador fields
  googleEventId      String?
  reminderSentAt     DateTime?
  reminderStatus     ReminderStatus    @default(PENDING)
  confirmationCode   String?           @default(cuid())
  patientConfirmed   Boolean           @default(false)
}

// ─── Enums existentes ──────────────────────────────────────────────────────────

enum Plan {
  STARTER
  PROFESIONAL
  CLINICA
}

enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum LeadSource {
  REFERIDO
  INSTAGRAM
  FACEBOOK
  GOOGLE
  TIKTOK
  WHATSAPP
  OTRO
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─── Enums nuevos del pipeline comercial ──────────────────────────────────────

enum LeadStatus {
  NUEVO
  CONTACTADO
  CITA_AGENDADA
  PRESUPUESTO_ENVIADO
  CONVERTIDO
  PERDIDO
}

enum DentalTreatment {
  ORTODONCIA
  IMPLANTES
  BLANQUEAMIENTO
  ENDODONCIA
  LIMPIEZA
  CIRUGIA
  PROTESIS
  OTRO
}

enum MarketingChannel {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  GOOGLE
  REFERIDO
  TIKTOK
  OTRO
}

enum MsgDirection {
  INBOUND
  OUTBOUND
}

enum MsgStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Enums del Agendador ───────────────────────────────────────────────────────

enum ReminderStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
  NOT_NEEDED
}

model UserInvitation {
  id          String    @id @default(cuid())
  email       String
  role        UserRole
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  invitedById String
  invitedBy   User      @relation("SentInvitations", fields: [invitedById], references: [id])
  token       String    @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([email, clinicId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Journey / Proceso Comercial ──────────────────────────────────────────────

model JourneyEvent {
  id          String        @id @default(cuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  type        EventType
  fromState   JourneyState?
  toState     JourneyState?
  metadata    Json?
  note        String?
  isAutomatic Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([leadId])
}

enum JourneyState {
  PROSPECTO
  CALIFICADO
  CITA_AGENDADA
  EN_CONSULTA
  PACIENTE_ACTIVO
  INACTIVO
  PERDIDO
}

enum BudgetRange {
  BAJO
  MEDIO
  ALTO
  PREMIUM
}

enum LostReason {
  PRECIO_ALTO
  ELIGIO_OTRA
  NO_RESPONDE
  NO_NECESITA
  MALA_EXPERIENCIA
  OTRO
}

enum EventType {
  STATE_CHANGED
  MESSAGE_SENT
  MESSAGE_RECEIVED
  CALL_MADE
  QUICK_REPLY_USED
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  NO_SHOW
  CLINICAL_NOTE_ADDED
  DICTATION_USED
  CONVERTED_TO_PATIENT
  LOST
  AI_QUALIFIED
  AI_SCHEDULED
  AI_REMINDER_SENT
  AI_REENGAGED
}

// ─── Canal Social — Perfiles de redes sociales ────────────────────────────────

model SocialProfile {
  id            String           @id @default(cuid())
  leadId        String
  lead          Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel       MarketingChannel
  externalId    String           // PSID de Facebook, IG user ID, etc.
  displayName   String?
  profilePicUrl String?
  locale        String?
  timezone      Int?
  rawProfile    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([channel, externalId])
  @@index([externalId])
}

// ─── Hermes Captador ──────────────────────────────────────────────────────────

model AgentConversation {
  id             String             @id @default(cuid())
  leadId         String             @unique
  lead           Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentType      AgentType          @default(CAPTADOR)
  status         ConversationStatus @default(ACTIVE)
  channel        MarketingChannel
  turnCount      Int                @default(0)
  lastAgentMsgAt DateTime?
  handedOffAt    DateTime?
  handoffReason  String?
  collectedData  Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

enum AgentType {
  CAPTADOR
  AGENDADOR
  REACTIVADOR
}

enum ConversationStatus {
  ACTIVE
  HANDED_OFF
  COMPLETED
  ABANDONED
}

// ─── AI Usage Tracking ────────────────────────────────────────────────────────

model AiUsageLog {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  agentKey      String
  model         String
  tokensInput   Int      @default(0)
  tokensOutput  Int      @default(0)
  audioDuration Float?
  costUsd       Float
  latencyMs     Int
  success       Boolean
  errorCode     String?
  createdAt     DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([agentKey, createdAt])
}

// ─── Hermes Reactivador ───────────────────────────────────────────────────────

model ReactivationCampaign {
  id                 String              @id @default(cuid())
  clinicId           String
  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  leadId             String
  lead               Lead                @relation(fields: [leadId], references: [id])

  segment            ReactivationSegment
  treatmentFocus     String?
  daysSinceLastAppt  Int

  status             CampaignStatus      @default(PENDING)
  attemptCount       Int                 @default(0)
  maxAttempts        Int                 @default(3)
  lastAttemptAt      DateTime?
  nextAttemptAt      DateTime?

  responded          Boolean             @default(false)
  respondedAt        DateTime?
  convertedAt        DateTime?
  revenue            Float?

  messages           CampaignMessage[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([clinicId, leadId])
  @@index([clinicId, status])
  @@index([nextAttemptAt])
}

model CampaignMessage {
  id             String               @id @default(cuid())
  campaignId     String
  campaign       ReactivationCampaign @relation(fields: [campaignId], references: [id])
  channel        MarketingChannel
  content        String               @db.Text
  attemptNumber  Int
  sentAt         DateTime             @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  repliedAt      DateTime?
  externalMsgId  String?
}

enum ReactivationSegment {
  TRATAMIENTO_INCOMPLETO
  CONTROL_PENDIENTE
  LARGO_PLAZO_INACTIVO
  PERDIO_PRESUPUESTO
  SIN_CLASIFICAR
}

enum CampaignStatus {
  PENDING
  ACTIVE
  RESPONDED
  CONVERTED
  EXHAUSTED
  CANCELLED
}
